{
    "compilerOptions": {
        "target": "ESNext",
        "module": "Preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["bun", "@cloudflare/workers-types"],
        "noUncheckedIndexedAccess": true
    }
}
